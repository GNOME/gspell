#: gspell/gspell-checker.c:397
#, c-format
msgid "Error when checking the spelling of word “%s”: %s"
msgstr "Feil ved kontroll av stavemåten til ordet «%s»: %s"

#. Translators: Displayed in the "Check Spelling"
#. * dialog if there are no suggestions for the current
#. * misspelled word.
#.
#. No suggestions. Put something in the menu anyway...
#: gspell/gspell-checker-dialog.c:132 gspell/gspell-context-menu.c:199
msgid "(no suggested words)"
msgstr "(ingen føreslåtte ord)"

#: gspell/gspell-checker-dialog.c:217
msgid "Error:"
msgstr "Feil:"

#: gspell/gspell-checker-dialog.c:253
msgid "Completed spell checking"
msgstr "Stavekontrollen er ferdig"

#: gspell/gspell-checker-dialog.c:257
msgid "No misspelled words"
msgstr "Ingen feilstava ord"

#. Translators: Displayed in the "Check
#. * Spelling" dialog if the current word
#. * isn't misspelled.
#.
#: gspell/gspell-checker-dialog.c:484
msgid "(correct spelling)"
msgstr "(rett stavemåte)"

#: gspell/gspell-checker-dialog.c:626
msgid "Suggestions"
msgstr "Forslag"

#: gspell/gspell-context-menu.c:134
msgid "_Language"
msgstr "_Språk"

#: gspell/gspell-context-menu.c:222
msgid "_More…"
msgstr "_Meir …"

#. Ignore all
#: gspell/gspell-context-menu.c:267
msgid "_Ignore All"
msgstr "_Ignorer alle"

#. Add to Dictionary
#: gspell/gspell-context-menu.c:285
msgid "_Add"
msgstr "_Legg til"

#: gspell/gspell-context-menu.c:322
msgid "_Spelling Suggestions…"
msgstr "_Staveforslag …"

#. Translators: %s is the language ISO code.
#: gspell/gspell-language.c:71
#, c-format
msgctxt "language"
msgid "Unknown (%s)"
msgstr "Ukjend (%s)"

#: gspell/gspell-language-chooser-button.c:66
msgid "No language selected"
msgstr "Ingen språk er valt"

#: gspell/gspell-navigator-text-view.c:292
msgid ""
"Spell checker error: no language set. It’s maybe because no dictionaries are "
"installed."
msgstr ""
"Stavekontrollfeil: ingen språk er valt. Det kan vere fordi ingen ordbøker er"
" installerte."

